# Copy this file to .env and adjust values before running `docker compose up --build`.
# Every value here has a safe local-dev default baked into docker-compose.yml;
# .env only needs to override what you don't want to keep as default (especially secrets).

# ---- PostgreSQL ----
POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=9094

# ---- Backend / Spring Boot ----
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# JWT_SECRET must be a base64-encoded value >= 256 bits (32 bytes) for HS256.
# Generate one with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# Default Bucket4j rate limit: N requests per REFILL_SECONDS window per API key / IP.
RATE_LIMIT_DEFAULT_CAPACITY=100
RATE_LIMIT_DEFAULT_REFILL_SECONDS=60

SHORT_CODE_LENGTH=7

# ---- Nginx ----
NGINX_HTTP_PORT=80

# ---- Grafana ----
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Prometheus ----
PROMETHEUS_PORT=9090
