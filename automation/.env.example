# Copy to .env and adjust for your environment. Values here match the default
# docker-compose.yml exposed ports for this repo's local stack.

# Environment name, drives config/environment.ts (local | docker | staging)
TEST_ENV=docker

# nginx serves the frontend AND proxies /api + short-code redirects (see infra/nginx/nginx.conf)
APP_BASE_URL=http://localhost
API_BASE_URL=http://localhost/api/v1/

# Seeded demo accounts (app.seed-demo-data=true), see backend application.yml
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo@12345
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# Direct Postgres connection, for DB-assertion helpers (docker-compose port mapping).
# If DB_PORT 5432 unexpectedly returns a schema that isn't this app's (e.g. querying
# information_schema.tables shows tables you don't recognize), something else on your
# machine - commonly a natively-installed Postgres service - already owns host port 5432
# and is shadowing Docker's port-forwarding for the postgres container. Confirm with
# `docker port <postgres-container>`; if Docker really is publishing 5432 but a DIFFERENT
# server answers there, remap the container's published port instead of fighting it:
# `POSTGRES_PORT=5433 docker compose up -d --force-recreate postgres` (see docker-compose.yml),
# then set DB_PORT=5433 here to match.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=urlshortener
DB_PASSWORD=urlshortener

# Playwright execution behaviour
HEADLESS=true
WORKERS=4
RETRIES=1
TRACE=retain-on-failure
VIDEO=retain-on-failure
SCREENSHOT=only-on-failure
